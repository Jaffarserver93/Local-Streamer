artifacts/api-server/videos/*.mkv
artifacts/api-server/videos/*.webm
artifacts/api-server/videos/*.mov
artifacts/api-server/videos/*.avi
artifacts/api-server/videos/*.m4v
artifacts/api-server/videos/*.ts
artifacts/api-server/videos/*.m2ts
artifacts/api-server/videos/*.wmv
artifacts/api-server/videos/*.flv

